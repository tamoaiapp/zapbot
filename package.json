{
  "name": "zapbot",
  "version": "0.1.2",
  "description": "WhatsApp auto-responder desktop app with local LLM (Ollama + Qwen)",
  "private": true,
  "author": "Tiago",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c blue,green \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && tsc -p tsconfig.electron.json && node scripts/dev-electron.mjs",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run build:renderer && npm run build:electron && electron-builder",
    "build:mac": "npm run build:renderer && npm run build:electron && electron-builder --mac",
    "build:win": "npm run build:renderer && npm run build:electron && electron-builder --win",
    "build:linux": "npm run build:renderer && npm run build:electron && electron-builder --linux",
    "postinstall": "node scripts/download-ollama.mjs && electron-builder install-app-deps",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "better-sqlite3": "^11.3.0",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "node-cron": "^3.0.3",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.16.10",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "lucide-react": "^0.451.0",
    "postcss": "^8.4.47",
    "qrcode.react": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "react-window": "^1.8.10",
    "@types/react-window": "^1.8.8",
    "tailwind-merge": "^2.5.3",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "wait-on": "^8.0.1",
    "zustand": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
